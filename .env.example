# Copy to .env (next to config.yaml) and `chmod 600 .env`. Loaded automatically at startup;
# variables already set in the environment take precedence. The agent can never read this file.
TELEGRAM_BOT_TOKEN=123456789:replace-me

# Only needed if you don't use `overseer login claude_code` / `overseer login codex`:
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_CODE_OAUTH_TOKEN=...
# OPENAI_API_KEY=sk-...
